# The build context is the repo root. Docker anchors patterns to the context
# root (unlike .gitignore), so anything that can live in a subdirectory
# (services/api/tests, services/api/venv, ...) needs a **/ prefix.

# VCS
.git/
.gitignore

# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.coverage
**/htmlcov/

# Virtualenvs and local databases
**/venv/
**/.venv/
**/*.db

# Local env files
**/.env
**/.env.local

# Not needed in the image
**/tests/
**/*.md
**/.DS_Store
docker-compose.yml
Makefile
